# One launchpad-owned OpenRouter account/key shared by every agent. Never expose it in browser code.
APP_ORIGIN=https://shen.now
# Public BNB Chain contract address for the main SHEN token. Leave blank until launched.
SHEN_TOKEN_ADDRESS=
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
BRAVE_API_KEY=
BNB_RPC_URL=
WORKER_TOKEN=
SIGNER_URL=
SIGNER_WEB_TOKEN=
SIGNER_SETTLEMENT_ADDRESS=0x4ed72eb56621de657d62007bc7a798d314d9765b
OPENROUTER_MANAGEMENT_KEY=
# Agent operations have no fixed daily monetary cap.
# Account-specific contracted cost ceiling for one Brave query.
BRAVE_COST_MICROUSD=
# Official X app: OAuth 2.0 Web App with Read and Write permissions.
# Callback: https://shen.now/api/social/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# App bearer token from the same X developer project, for credit checks.
X_API_BEARER_TOKEN=
# Separate permanent 64-hex key for encrypted X sessions; back it up.
SERVICE_CREDENTIALS_KEY=
# Platform-paid onboarding ceiling; agent-funded publishing rates, in micro-USD.
X_LOGIN_DAILY_LIMIT_MICROUSD=1000000
X_POST_COST_MICROUSD=15000
X_POST_URL_COST_MICROUSD=200000
# Confirm your media-upload rate in the X console; blank disables X image uploads.
# Use 0 only if your account explicitly prices uploads as free.
X_UPLOAD_COST_MICROUSD=
# Up to ten posts per reconciliation read, at 5000 micro-USD per post.
X_READ_COST_MICROUSD=50000
# Required hard platform cost cap for Q&A, in micro-USD; no default spending authority.
CHAT_DAILY_LIMIT_MICROUSD=
# Custom-domain automation only. Not needed for shen.now/sites/<coin-id> hosting.
# These settings do not fund OpenRouter; OpenRouter uses the SolCard route above.
# Shared registrar account; enable API access for newly registered domains.
# Both web and signer use these credentials, never the browser.
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
# Opt in only after registrar verification, spending limits and hosting setup.
# false disables automated custom domains and treasury-funded registrar top-ups.
DOMAIN_AUTO_FUNDING_ENABLED=false
# Signer only: Base RPC for USDC domain payments to Porkbun.
# The existing encrypted agent EOA is also used on Base; no new key.
BASE_RPC_URL=
RELAY_API_KEY=
# Web only: your own VPS's Dokploy API attaches purchased domains and HTTPS routes.
# HTTPS origin, API credential and exact SHEN Docker Compose ID.
DOKPLOY_URL=
DOKPLOY_API_KEY=
DOKPLOY_COMPOSE_ID=
# Same server's routable public IPv4, used for the apex A record and verification.
HOSTING_IPV4=

# Isolated read-only research browser (Dokploy supplies the internal URL).
BROWSER_URL=
BROWSER_TOKEN=

# Optional AI influencer (Higgsfield). Rates are micro-USD charged to coin credit.
# Blank image or character rate disables it; a blank video rate means photos only.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_IMAGE_COST_MICROUSD=
HIGGSFIELD_VIDEO_COST_MICROUSD=
HIGGSFIELD_CHARACTER_COST_MICROUSD=
HIGGSFIELD_VIDEO_MODEL=kling
INFLUENCER_DAILY_POSTS=6
INFLUENCER_VIDEO_PERCENT=50
INFLUENCER_CREDIT_FLOOR_MICROUSD=1000000
