# One launchpad-owned OpenRouter account/key shared by every agent. Never expose it in browser code.
APP_ORIGIN=https://shen.now
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
BRAVE_API_KEY=
BNB_RPC_URL=
WORKER_TOKEN=
SIGNER_URL=
SIGNER_WEB_TOKEN=
SIGNER_SETTLEMENT_ADDRESS=
OPENROUTER_MANAGEMENT_KEY=
# Agent operations have no fixed daily monetary cap.
# Account-specific contracted cost ceiling for one Brave query.
BRAVE_COST_MICROUSD=
TWITTERAPI_IO_KEY=
# Residential proxy URL, including its credentials. Server-side only.
TWITTERAPI_IO_PROXY=
# Separate permanent 64-hex key for encrypted X sessions; back it up.
SERVICE_CREDENTIALS_KEY=
# Platform-paid onboarding ceiling; agent-funded publishing rates, in micro-USD.
X_LOGIN_DAILY_LIMIT_MICROUSD=1000000
X_POST_COST_MICROUSD=3000
X_UPLOAD_COST_MICROUSD=3000
# Maximum reservation for one reconciliation read; actual reads cost 150 per tweet.
X_READ_COST_MICROUSD=5000
# Required hard platform cost cap for Q&A, in micro-USD; no default spending authority.
CHAT_DAILY_LIMIT_MICROUSD=
# Shared registrar account; enable API access for newly registered domains.
# Both web and signer use these credentials, never the browser.
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
# Opt in only after registrar verification, spending limits and hosting setup.
# false disables automated custom domains and treasury-funded registrar top-ups.
DOMAIN_AUTO_FUNDING_ENABLED=false
# Signer only. The existing encrypted agent EOA is also used on Base; no new key.
BASE_RPC_URL=
RELAY_API_KEY=
# Web only. HTTPS origin, API credential and exact SHEN Docker Compose ID.
DOKPLOY_URL=
DOKPLOY_API_KEY=
DOKPLOY_COMPOSE_ID=
# Same server's routable public IPv4, used for the apex A record and verification.
HOSTING_IPV4=
