# Paste into Dokploy Environment. Never commit filled-in values.
APP_ORIGIN=https://shen.now
# Public BNB Chain contract address for the main SHEN token. Leave blank until launched.
SHEN_TOKEN_ADDRESS=
# Generate different values for all six: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
SIGNER_MASTER_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
SIGNER_WEB_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
SIGNER_WORKER_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
WORKER_TOKEN=REPLACE_WITH_A_SEPARATE_64_RANDOM_HEX_VALUE
SERVICE_CREDENTIALS_KEY=REPLACE_WITH_A_SEPARATE_64_RANDOM_HEX_VALUE
BNB_RPC_URL=
# Confirmed reusable SolCard BNB Chain address. Deposit range: 0.01–65.77 BNB.
# Enable OpenRouter card auto top-up and seed its initial prepaid credits.
SIGNER_SETTLEMENT_ADDRESS=0x4ed72eb56621de657d62007bc7a798d314d9765b
# Platform safety policy. These are never creator-editable.
SIGNER_GAS_RESERVE_WEI=2000000000000000
SIGNER_MAX_GAS_PRICE_WEI=3000000000
SIGNER_SLIPPAGE_BPS=100
SIGNER_BUYBACKS_ENABLED=false
# Shared launchpad account; inference key and management key have separate scopes.
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
# Agent operations have no daily money cap. They require funded service credit.
# This separate limit applies to visitor Q&A.
CHAT_DAILY_LIMIT_MICROUSD=0
BRAVE_API_KEY=
BRAVE_COST_MICROUSD=0
# Official X app: OAuth 2.0 Web App with Read and Write permissions.
# Callback: https://shen.now/api/social/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# App bearer token from the same X developer project, for credit checks.
X_API_BEARER_TOKEN=
# Platform-paid X onboarding cap and agent-funded publishing rates, in micro-USD.
X_LOGIN_DAILY_LIMIT_MICROUSD=1000000
X_POST_COST_MICROUSD=15000
X_POST_URL_COST_MICROUSD=200000
# Confirm your media-upload rate in the X console; blank disables X image uploads.
# Use 0 only if your account explicitly prices uploads as free.
X_UPLOAD_COST_MICROUSD=
# Up to ten posts per reconciliation read, at 5000 micro-USD per post.
X_READ_COST_MICROUSD=50000
# Custom-domain automation only. Not needed for shen.now/sites/<coin-id> hosting.
# These settings do not fund OpenRouter; OpenRouter uses the SolCard route above.
# Verified platform registrar account. Turn on Opt In All Domains in Porkbun.
# Registration custody stays with the platform; each coin has its own expense ledger.
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
# Set true after the registrar, bridge and hosting checks are complete.
# Defaults false: automated custom domains and registrar top-ups stay disabled.
DOMAIN_AUTO_FUNDING_ENABLED=false
# Signer only: Base mainnet RPC (chain 8453) for USDC domain payments to Porkbun.
# No separate Base private key.
BASE_RPC_URL=
# Signer only; optional depending on your Relay account.
RELAY_API_KEY=
# Web only: your own VPS's Dokploy API attaches purchased domains and HTTPS routes.
# Origin such as https://deploy.example.com, without /api or credentials.
DOKPLOY_URL=
DOKPLOY_API_KEY=
# Exact ID of this SHEN Docker Compose service, not a project/environment ID.
DOKPLOY_COMPOSE_ID=
# Public IPv4 of the server hosting the gateway; no proxy/CDN address.
HOSTING_IPV4=
