# Paste into Dokploy Environment. Never commit filled-in values.
APP_ORIGIN=https://shen.now
# Generate different values for all six: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
SIGNER_MASTER_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
SIGNER_WEB_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
SIGNER_WORKER_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
WORKER_TOKEN=REPLACE_WITH_A_SEPARATE_64_RANDOM_HEX_VALUE
SERVICE_CREDENTIALS_KEY=REPLACE_WITH_A_SEPARATE_64_RANDOM_HEX_VALUE
BNB_RPC_URL=
# Your platform's dedicated public BNB billing address, not an agent address.
SIGNER_SETTLEMENT_ADDRESS=
# Platform safety policy. These are never creator-editable.
SIGNER_GAS_RESERVE_WEI=2000000000000000
SIGNER_MAX_GAS_PRICE_WEI=3000000000
SIGNER_SLIPPAGE_BPS=100
SIGNER_BUYBACKS_ENABLED=false
# Shared launchpad account; inference key and management key have separate scopes.
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
# Agent operations have no daily money cap. They require funded service credit.
# This separate limit applies to visitor Q&A.
CHAT_DAILY_LIMIT_MICROUSD=0
BRAVE_API_KEY=
BRAVE_COST_MICROUSD=0
TWITTERAPI_IO_KEY=
# Residential proxy URL including authentication, used only by the posting service.
TWITTERAPI_IO_PROXY=
# Platform-paid X onboarding cap and agent-funded publishing rates, in micro-USD.
X_LOGIN_DAILY_LIMIT_MICROUSD=1000000
X_POST_COST_MICROUSD=3000
X_UPLOAD_COST_MICROUSD=3000
# Reservation ceiling per reconciliation read; actual cost is 150 per returned tweet.
X_READ_COST_MICROUSD=5000
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
RELAY_API_KEY=
